{
  "_comment": [
    "Test matrix for the 'Preset Model Regression Test' workflow (.github/workflows/preset-model-regression.yaml).",
    "One dedicated AKS cluster is created per gpuPool and the models targeting that pool are deployed one at a time.",
    "A target means: provision `nodes` node(s) of a SKU with `gpusPerNode` GPUs and wait for the Workspace to reach",
    "InferenceReady=True. `nodes` is the expected output of the KAITO node estimator; the workflow reports a",
    "warning (not a failure) when status.targetNodeCount differs, since the estimator picks the real count.",
    "Set `skip: true` on a model to exclude it from every pool; `skipReason` is shown in the report."
  ],
  "gpuPools": {
    "a10": {
      "displayName": "NVIDIA A10",
      "region": "swedencentral",
      "fallbackRegion": "polandcentral",
      "instanceTypes": {
        "1": "Standard_NV36ads_A10_v5",
        "2": "Standard_NV72ads_A10_v5"
      }
    },
    "a100": {
      "displayName": "NVIDIA A100 80GB",
      "region": "eastus",
      "fallbackRegion": "westeurope",
      "instanceTypes": {
        "1": "Standard_NC24ads_A100_v4",
        "2": "Standard_NC48ads_A100_v4",
        "4": "Standard_NC96ads_A100_v4"
      }
    },
    "h100": {
      "displayName": "NVIDIA H100",
      "region": "australiaeast",
      "fallbackRegion": "",
      "instanceTypes": {
        "1": "Standard_NC40ads_H100_v5",
        "2": "Standard_NC80adis_H100_v5",
        "8": "Standard_ND96isr_H100_v5"
      }
    }
  },
  "defaults": {
    "timeoutMinutes": 60
  },
