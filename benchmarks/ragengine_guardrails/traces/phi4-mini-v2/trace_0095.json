t={Home} />\n        <Route path=\"/login\" component={Login} />\n        <Route path=\"/profile\" component={Profile} />\n     Switch>\n    </Router>\n  );\n}\n```\n\n**Step 4:** Style components using styled-components or Material-UI as per your design.\n- Home.js example:\n```jsximport React from 'react';\nimport { Container } from '@material-ui/core';\n\nfunction Home() {\n  return (\n    <Container>\n",
